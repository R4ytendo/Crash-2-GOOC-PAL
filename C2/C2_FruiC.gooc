#gool FruiC 3 4

#include "goolstdlib.gooc"

#sprite FRUIT_WUMPA [Cr10T]
#tex 0x808080 1 0 0 3 32 32 32 32
#tex 0x808080 1 0 0 3 64 96 32 32
#tex 0x808080 1 0 0 3 64 64 32 32
#tex 0x808080 1 0 0 3 64 32 32 32
#tex 0x808080 1 0 0 3 96 96 32 32
#tex 0x808080 1 0 0 3 96 64 32 32
#tex 0x808080 1 0 0 3 96 32 32 32
#tex 0x808080 1 0 0 3 128 96 32 32
#tex 0x808080 1 0 0 3 128 64 32 32
#tex 0x808080 1 0 0 3 128 32 32 32
#tex 0x808080 1 0 0 3 160 96 32 32
#tex 0x808080 1 0 0 3 160 64 32 32
#tex 0x808080 1 0 0 3 160 32 32 32
#tex 0x808080 1 0 0 3 192 96 32 32
#sprite FRUIT_1UP [Cr10T]
#tex 0x808080 0 0 7 6 64 64 64 32
#anim FRUIT_DOCTOR   [WD10V] 1 0   // 0x4000
#anim FRUIT_CRYSTAL  [Cry1V] 1 0   // 0x4300
#anim FRUIT_GEM_A    [Ge10V] 1 0   // 0x4600
#anim FRUIT_GEM_B    [Ge30V] 1 0   // 0x4900
